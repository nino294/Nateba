{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "nateba.vercel.app" }],
      "destination": "https://www.classeli.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
